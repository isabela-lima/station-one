# Supabase — Settings → API → Project URL
SUPABASE_URL=https://<seu-projeto>.supabase.co

# Supabase — Settings → API → service_role key (MANTER SECRETO)
SUPABASE_SECRET_KEY=<service-role-key>

# Supabase — Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=<jwt-secret>

# Supabase — Connect → Transaction pooler (porta 6543), com o driver asyncpg
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# development | production
ENVIRONMENT=development

# Origens permitidas no CORS (frontend)
CORS_ORIGINS=http://localhost:5173
