# Supabase — Settings → API → Project URL
SUPABASE_URL=https://<seu-projeto>.supabase.co

# Supabase — Settings → API → service_role key (MANTER SECRETO)
SUPABASE_SECRET_KEY=<service-role-key>

# Supabase — Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=<jwt-secret>

# Supabase — Connect → Session pooler (porta 5432), com o driver asyncpg.
# Não use a 6543 (modo transaction): com o pool de conexões da API, consultas em
# paralelo falham ("prepared statement does not exist").
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# development | production
ENVIRONMENT=development

# Opcional: imprime cada SQL com os valores (só para depurar)
# SQL_ECHO=true

# Origens permitidas no CORS (frontend)
CORS_ORIGINS=http://localhost:5173
