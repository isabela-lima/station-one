# Supabase — Settings → API → Project URL
PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co

# Supabase — Settings → API Keys → publishable key
PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Onde o servidor do frontend encontra o FastAPI (o navegador sempre usa /api).
# Opcional; o padrão é este:
# API_INTERNAL_URL=http://127.0.0.1:8000
